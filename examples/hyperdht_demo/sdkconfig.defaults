CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# libudx paces with 1 ms timers
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CONNECT_IPV6=n
CONFIG_EXAMPLE_PROVIDE_WIFI_CONSOLE_CMD=n

# the default of 6 drops bursts while the loop is busy (research/phase0/README.md)
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# keep reconnecting to Wi-Fi however long the access point is gone
# (the example helper gives up after 6 tries and stays offline)
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=1000000000
