CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Required by hdht (see the main README)
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# Only for the default network's settings (CONFIG_EXAMPLE_WIFI_*); the module
# runs its own WiFi code
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CONNECT_IPV6=n
CONFIG_EXAMPLE_PROVIDE_WIFI_CONSOLE_CMD=n

# The commands use USB Serial/JTAG, so the console and logs go to UART0
# (GPIO21 TX / GPIO20 RX) instead. With CONFIG_MODULE_PORT_UART, the console
# can stay on USB.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# MQTT runs over HyperDHT (components/hdht_mqtt): no TLS or WebSocket transports
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
