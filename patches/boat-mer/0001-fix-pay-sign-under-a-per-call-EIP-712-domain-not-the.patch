diff --git a/tests/test_domain_race.c b/tests/test_domain_race.c
new file mode 100644
index 0000000..1af29e1
--- /dev/null
+++ b/tests/test_domain_race.c
@@ -0,0 +1,76 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ * Copyright 2024-2026 BoAT MER Contributors
+ *
+ * Two threads sign EIP-3009 authorizations at the same time, each under its
+ * own EIP-712 domain (a Circle Gateway batched domain and a token domain),
+ * as a device does when its nanopayment buyer, its anchoring and its x402
+ * client run on different tasks. Signing is deterministic (RFC 6979), so
+ * every signature must equal the one the same call makes alone.
+ *
+ * Build: see tests/Makefile (needs pthreads).
+ */
+
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "boat_crypto.h"
+#include "boat_nano.h"
+
+#define ROUNDS 400
+
+static boat_keypair_t kp;
+static uint8_t to[20] = {0x27, 0xf3};
+static uint8_t gateway[20] = {0x00, 0x77, 0x77};
+static uint8_t token[20] = {0x36};
+
+typedef struct {
+    const char *name, *version;
+    const uint8_t *contract;
+    uint8_t expected[ROUNDS][32];
+    int wrong;
+} job_t;
+
+static void
+sign_one(job_t *j, int i, uint8_t r_out[32])
+{
+    boat_nano_slice_t slice = {.slice_id = (uint32_t)i, .valid_after = 0, .valid_before = 1900000000u};
+    memset(slice.nonce, i & 0xff, 32);
+    slice.nonce[0] = (uint8_t)(i >> 8);
+    boat_nano_auth_t auth;
+    boat_nano_sign(&kp, to, 1000 + (uint64_t)i, 5042002, j->contract, j->name, j->version, &slice, &auth);
+    memcpy(r_out, auth.r, 32);
+}
+
+static void *
+run(void *arg)
+{
+    job_t *j = arg;
+    for (int i = 0; i < ROUNDS; i++) {
+        uint8_t r[32];
+        sign_one(j, i, r);
+        if (memcmp(r, j->expected[i], 32) != 0) j->wrong++;
+    }
+    return NULL;
+}
+
+int
+main(void)
+{
+    if (boat_crypto_init(&kp) != BOAT_OK) return 1;
+    job_t a = {.name = "GatewayWalletBatched", .version = "1", .contract = gateway};
+    job_t b = {.name = "USDC", .version = "2", .contract = token};
+    for (int i = 0; i < ROUNDS; i++) {
+        sign_one(&a, i, a.expected[i]);
+        sign_one(&b, i, b.expected[i]);
+    }
+    pthread_t ta, tb;
+    pthread_create(&ta, NULL, run, &a);
+    pthread_create(&tb, NULL, run, &b);
+    pthread_join(ta, NULL);
+    pthread_join(tb, NULL);
+    printf("%s concurrent signing under two domains: %d + %d of %d signatures wrong\n",
+           a.wrong + b.wrong ? "FAIL" : "PASS", a.wrong, b.wrong, 2 * ROUNDS);
+    return a.wrong + b.wrong ? 1 : 0;
+}
