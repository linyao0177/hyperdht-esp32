+                                  const boat_payment_t *params,
+                                  uint32_t chain_id,
+                                  const uint8_t contract[20],
+                                  const char *name,
+                                  const char *version,
+                                  uint8_t sig[65]);
+
 /*
  * Submit signed payment authorization to the relay.
  * POST {relay_url}/v1/payment/execute
