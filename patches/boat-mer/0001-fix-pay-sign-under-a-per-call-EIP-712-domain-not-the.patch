diff --git a/src/pay/boat_pay.c b/src/pay/boat_pay.c
index 1caef0a..8114792 100644
--- a/src/pay/boat_pay.c
+++ b/src/pay/boat_pay.c
@@ -22,17 +22,17 @@ const uint8_t *boat_eip712_get_domain_separator(void);
 
 /* boat_pay_set_domain is implemented in boat_eip712.c */
 
-boat_err_t boat_pay_authorize(const boat_keypair_t *kp,
-                              const boat_payment_t *params,
-                              uint8_t sig[65])
+boat_err_t boat_eip712_domain_separator_ext(uint32_t chain_id,
+                                            const uint8_t contract[20],
+                                            const char *name, size_t name_len,
+                                            const char *version, size_t version_len,
+                                            uint8_t out[32]);
+
+static boat_err_t authorize_with(const boat_keypair_t *kp,
+                                 const boat_payment_t *params,
+                                 const uint8_t domain_sep[32],
+                                 uint8_t sig[65])
 {
-    if (!kp || !params || !sig)
-        return BOAT_ERR_INVALID_ARG;
-
-    const uint8_t *domain_sep = boat_eip712_get_domain_separator();
-    if (!domain_sep)
-        return BOAT_ERR_NOT_INITIALIZED;
-
     /* Compute structHash for TransferWithAuthorization */
     uint8_t struct_hash[32];
     boat_err_t err = boat_eip712_transfer_auth_hash(kp->eth_address, params, struct_hash);
@@ -49,6 +49,44 @@ boat_err_t boat_pay_authorize(const boat_keypair_t *kp,
     return boat_secp256k1_sign(kp, digest, sig);
 }
 
+boat_err_t boat_pay_authorize(const boat_keypair_t *kp,
+                              const boat_payment_t *params,
+                              uint8_t sig[65])
+{
+    if (!kp || !params || !sig)
+        return BOAT_ERR_INVALID_ARG;
+
+    const uint8_t *global = boat_eip712_get_domain_separator();
+    if (!global)
+        return BOAT_ERR_NOT_INITIALIZED;
+
+    /* copy it first: another task may set a new domain while this one signs */
+    uint8_t domain_sep[32];
+    memcpy(domain_sep, global, 32);
+    return authorize_with(kp, params, domain_sep, sig);
+}
+
+boat_err_t boat_pay_authorize_ext(const boat_keypair_t *kp,
+                                  const boat_payment_t *params,
+                                  uint32_t chain_id,
+                                  const uint8_t contract[20],
+                                  const char *name,
+                                  const char *version,
+                                  uint8_t sig[65])
+{
+    if (!kp || !params || !contract || !name || !version || !sig)
+        return BOAT_ERR_INVALID_ARG;
+
+    uint8_t domain_sep[32];
+    boat_err_t err = boat_eip712_domain_separator_ext(chain_id, contract,
+                                                      name, strlen(name),
+                                                      version, strlen(version),
+                                                      domain_sep);
+    if (err != BOAT_OK)
+        return err;
+    return authorize_with(kp, params, domain_sep, sig);
+}
+
 boat_err_t boat_pay_submit(const boat_config_t *cfg,
                            const boat_payment_t *pay,
                            const uint8_t sig[65])
