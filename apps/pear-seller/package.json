{
  "name": "boat-pear-seller",
  "version": "0.1.0",
  "description": "A Pear app that sells power to BoAT MER devices over Holepunch, checks every EIP-3009 payment, and keeps the receipts in a Hypercore",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://se7oustyqqxgfz7c5fku7qqo5pob6965hxnwy98jexjt53831ory",
  "scripts": {
    "start": "node_modules/bare/bin/bare bin.mjs --no-updates",
    "verify": "node verify-receipts.js",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "b4a": "1.9.0",
    "bare-fs": "4.8.4",
    "bare-os": "3.9.3",
    "bare-path": "3.1.2",
    "bare-process": "4.5.1",
    "bare-storage": "1.1.1",
    "boat-peer": "file:../../packages/boat-peer",
    "corestore": "7.16.1",
    "framed-stream": "1.0.1",
    "graceful-goodbye": "1.3.3",
    "hyperdht": "6.35.0",
    "hyperswarm": "4.17.2",
    "paparam": "1.14.0",
    "pear-mobile": "4.3.0",
    "pear-runtime": "1.3.1",
    "ready-resource": "1.2.0",
    "sodium-universal": "5.0.1",
    "which-runtime": "1.4.0"
  },
  "devDependencies": {
    "bare": "1.36.2",
    "bare-build": "1.6.0",
    "bare-runtime": "1.36.0"
  },
  "license": "Apache-2.0",
  "imports": {
    "pear-runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  }
}
